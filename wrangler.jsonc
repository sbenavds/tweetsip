{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweetsip",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "BETTER_AUTH_URL": "https://tweetsip.sbenavds-account.workers.dev",
  },
  "triggers": {
    "crons": ["0 8 * * *", "0 * * * *"],
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT_MONITOR",
        "class_name": "AccountMonitor",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountMonitor"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tweetsip-db-staging",
      "database_id": "b9bdcea7-4a22-40df-abdc-3ea76e9e4734",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "tweetsip-data-staging",
      "preview_bucket_name": "tweetsip-data-staging",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "tweetsip-jobs-staging",
      },
    ],
    "consumers": [
      {
        "queue": "tweetsip-jobs-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
}
